        "## HYPOTHESIS TESTING"
      ],
      "metadata": {
        "id": "EBj8WYrwf68C"
      }
    },
    {
      "cell_type": "markdown",
      "source": [
        "1 SAMPLE MEAN"
      ],
      "metadata": {
        "id": "MxOJeonXp-LD"
      }
    },
    {
      "cell_type": "code",
      "execution_count": 7,
      "metadata": {
        "id": "OyiUIc2FTJcA"
      },
      "outputs": [],
      "source": [
        "import numpy as np\n",
        "from scipy import stats"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Data;\n",
        "data= [12,15,19,12,14,16,17,13,10]"
      ],
      "metadata": {
        "id": "2HxBDCrlTMsW"
      },
      "execution_count": 10,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# known population mean;\n",
        "pop_mean=15"
      ],
      "metadata": {
        "id": "0w9w9PT9TM7c"
      },
      "execution_count": 12,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Performing one sample t-test;\n",
        "t_stat,p_value= stats.ttest_1samp(data,pop_mean)\n",
        "print(f\" T-Statistic : {t_stat}\")\n",
        "print(f\"p_value : {p_value}\")\n",
        "\n",
        "if p_value < 0.05:\n",
        "   print(\"Reject null hypothesis , (Significant difference)\")\n",
        "else:\n",
        "  print(\"Fail to reject null hypothesis, (No significant difference)\")"
      ],

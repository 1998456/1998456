        "2 SAMPLE DATASET"
      ],
      "metadata": {
        "id": "GMoI6TbIqG1u"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Data;\n",
        "G1= [12,13,14,12,17]\n",
        "G2= [14,25,17,18,19]\n",
        "\n"
      ],
      "metadata": {
        "id": "hah_dnr1kBHD"
      },
      "execution_count": 15,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Perforing 2 sample t-test;\n",
        "t_test,p_value= stats.ttest_ind(G1,G2)\n",
        "print(f\"T-Statistic : {t_test}\")\n",
        "print(f\"p_value : {p_value}\")\n",
        "\n",
        "if p_value < 0.05:\n",
        "   print(\"Reject null hypothesis , (Significant difference)\")\n",
        "else:\n",
        "  print(\"Fail to reject null hypothesis, (No significant difference)\")"
      ],
